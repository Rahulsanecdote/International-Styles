# International Styles Barber Shop - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# REQUIRED - Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard at https://app.supabase.com
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# REQUIRED - Booksy Integration
# ============================================
# Your Booksy business ID for the booking widget
# Find this in your Booksy dashboard or contact Booksy support

NEXT_PUBLIC_BOOKSY_BUSINESS_ID=your-booksy-business-id

# ============================================
# OPTIONAL - Google Places API
# ============================================
# For fetching Google reviews
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable Places API for your project

GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACES_ID=your-google-place-id

# ============================================
# OPTIONAL - Yelp Fusion API
# ============================================
# For fetching Yelp reviews
# Get API key from: https://www.yelp.com/developers/v3/manage_app

YELP_API_KEY=your-yelp-api-key
YELP_BUSINESS_ID=your-yelp-business-id

# ============================================
# Notes
# ============================================
# - NEXT_PUBLIC_* variables are exposed to the browser
# - Server-only variables (without NEXT_PUBLIC_) are kept private
# - Google and Yelp integrations are optional
# - The review system will work with Supabase alone if you don't provide external API keys
